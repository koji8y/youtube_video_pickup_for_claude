# Anthropic API キー（必須）
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# MongoDB 接続先（docker-compose のサービス名に合わせる）
MONGO_URI=mongodb://mongodb:27017/LibreChat

# JWT シークレット（ランダムな長い文字列を設定する）
JWT_SECRET=change_me_to_a_random_long_string
JWT_REFRESH_SECRET=change_me_to_another_random_long_string

# アプリのホスト設定
HOST=0.0.0.0
PORT=3080
